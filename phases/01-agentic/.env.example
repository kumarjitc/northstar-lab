# direct (default) | rest
TOOL_BACKEND=direct

# Required only when TOOL_BACKEND=rest
NORTHSTAR_REST_BASE_URL=http://127.0.0.1:3000
REST_REQUEST_TIMEOUT_MS=5000

# Model — Mistral (default)
# Put secrets in this file (phases/01-agentic/.env). The CLI loads it automatically.
MODEL_PROVIDER=mistral
MODEL_API_KEY=
# or: MISTRAL_API_KEY=
MODEL_BASE_URL=https://api.mistral.ai/v1
MODEL_NAME=mistral-small-latest
# alternatives: mistral-large-latest, mistral-medium-latest, codestral-latest

# Other providers:
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# Paths
NORTHSTAR_DATA_DIR=
NORTHSTAR_KNOWLEDGE_DIR=
LOG_DIR=

# Agent loop
AGENT_MAX_ITERATIONS=6
AGENT_TURN_TIMEOUT_MS=30000
