# Host model (same as other agentic phases)
MODEL_PROVIDER=mistral
MODEL_API_KEY=
MODEL_NAME=

# Billing path: MCP child (Phase 2 server entry) backend
MIXED_BILLING_MCP_BACKEND=direct
# MIXED_BILLING_MCP_BACKEND=rest   # requires npm run rest

# Contract path: always REST → Phase 0
NORTHSTAR_REST_BASE_URL=http://127.0.0.1:3000
REST_REQUEST_TIMEOUT_MS=5000

# Service A2A agent
MIXED_SERVICE_HOST=127.0.0.1
MIXED_SERVICE_PORT=4202
MIXED_A2A_TIMEOUT_MS=20000

AGENT_MAX_ITERATIONS=8
AGENT_TURN_TIMEOUT_MS=60000
MCP_CALL_TIMEOUT_MS=20000
