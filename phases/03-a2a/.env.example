# mcp-direct (default) | mcp-rest
A2A_CAPABILITY_BACKEND=mcp-direct

# Required only when A2A_CAPABILITY_BACKEND=mcp-rest
NORTHSTAR_REST_BASE_URL=http://127.0.0.1:3000
REST_REQUEST_TIMEOUT_MS=5000

# Specialist ports
A2A_HOST=127.0.0.1
A2A_BILLING_PORT=4101
A2A_SERVICE_PORT=4102
A2A_CONTRACT_PORT=4103

# Model (orchestrator + specialists)
MODEL_PROVIDER=mistral
MODEL_API_KEY=
MODEL_BASE_URL=https://api.mistral.ai/v1

# Timeouts
AGENT_MAX_ITERATIONS=8
AGENT_TURN_TIMEOUT_MS=60000
A2A_TIMEOUT_MS=45000
MCP_CALL_TIMEOUT_MS=15000
